# The plugin itself has no dependencies at all; these are the harness's.
.devtools/node_modules/
.devtools/package-lock.json
node_modules/
*.log

# Scratch output from the verification runs.
/tmp/
*.tmp

# Screenshots the probes drop next to themselves when a run is cut short before
# its output directory is applied. Only the harness should ever produce these.
.devtools/*.png
